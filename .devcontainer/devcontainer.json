{
    "name": "Itinerary Processor Builder",
    "image": "mcr.microsoft.com/devcontainers/base:ubuntu-22.04",
    "features": {
        "ghcr.io/devcontainers/features/java:1": {
            "version": "17",
            "jdkDistro": "temurin"
        },
        "ghcr.io/devcontainers/features/python:1": {
            "version": "3.11"
        }
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "charliermarsh.ruff",
                "ms-python.debugpy"
            ]
        }
    },
    "postCreateCommand": "bash .devcontainer/setup.sh",
    "remoteUser": "root",
    "forwardPorts": [8000, 8080],
    "portsAttributes": {
        "8000": {
            "label": "API Server",
            "onAutoForward": "notify"
        },
        "8080": {
            "label": "Web UI",
            "onAutoForward": "notify"
        }
    }
}
